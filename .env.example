# Local — SQLite (défaut, accès immédiat)
DATABASE_URL="file:./dev.db"

# Production — Supabase (passer schema Prisma en postgresql + DIRECT_URL)
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

NEXTAUTH_URL="http://localhost:3020"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Emails autorisés à /admin (séparés par des virgules)
ADMIN_EMAILS="gerant@marginshop.app"

# Connexion auto démo — UNIQUEMENT en local. Laisser vide / 0 en prod.
DEMO_AUTO_LOGIN="1"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# SMS OTP signup (numéro voix/SMS Twilio, pas le whatsapp:…)
TWILIO_SMS_FROM=
# TWILIO_PHONE_NUMBER=  # alias accepté si TWILIO_SMS_FROM vide
# Templates Content API (HX…) — voir WHATSAPP_ALERTS.md
TWILIO_WA_TEMPLATE_STOCK_RECAP=
TWILIO_WA_TEMPLATE_STOCK_ALERT=
TWILIO_WA_TEMPLATE_BILLING_DUNNING=
TWILIO_WA_TEMPLATE_TEST=
# Batch / coût
WHATSAPP_BATCH_MINUTES=15
WHATSAPP_DAILY_LIMIT_PER_TENANT=20
WHATSAPP_COST_CENTS_PER_MSG=5
# WHATSAPP_REQUIRE_TEMPLATES=1
CRON_SECRET=
WEBHOOK_BASE_URL=http://localhost:3020
CREDENTIALS_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Newsletter + OTP email (Resend)
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL="Margin <contact@marginshop.app>"
# Sans RESEND_API_KEY : OTP email loggé en console (hors production uniquement)

# Stripe (test puis live)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COMMERCE_MONTHLY=
STRIPE_PRICE_COMMERCE_YEARLY=
STRIPE_PRICE_RESEAU_MONTHLY=
STRIPE_PRICE_RESEAU_YEARLY=
# Coupon affiliation −20 % 1ère facture (id stable margin_ref_20_once si vide)
STRIPE_COUPON_AFFILIATE=
# Grâce accès après échec de paiement (jours, 1–14, défaut 7)
STRIPE_GRACE_DAYS=7

# Calendly — démo / config WhatsApp 30 min (landing #demo)
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/votre-compte/margin-30min"
