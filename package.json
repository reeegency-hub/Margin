{
  "name": "margin-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:clean": "rm -rf .next && next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "db:reset": "prisma migrate reset --force",
    "db:up": "docker compose up -d",
    "db:use-sqlite": "bash scripts/switch-db-provider.sh sqlite",
    "db:use-postgres": "bash scripts/switch-db-provider.sh postgresql",
    "infra:secrets": "bash scripts/gen-prod-secrets.sh",
    "client:create": "tsx scripts/create-client.ts",
    "retail:import": "tsx scripts/import-retail-catalog.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "cron:stock": "curl -s \"http://localhost:3020/api/cron/stock-alerts${CRON_SECRET:+?secret=$CRON_SECRET}\"",
    "cron:pos": "curl -s \"http://localhost:3020/api/cron/pos-process${CRON_SECRET:+?secret=$CRON_SECRET}\"",
    "cron:pos-recon": "curl -s \"http://localhost:3020/api/cron/pos-recon${CRON_SECRET:+?secret=$CRON_SECRET}\"",
    "cron:stripe": "curl -s \"http://localhost:3020/api/cron/stripe-sync${CRON_SECRET:+?secret=$CRON_SECRET}\"",
    "test:load:pos": "tsx scripts/load-test-pos.ts",
    "drp:drill": "bash scripts/drp-restore-drill.sh",
    "test:unit": "tsx src/lib/stock-engine.test.ts && tsx src/lib/voice-intent.test.ts && tsx src/lib/whatsapp/config.test.ts && tsx src/lib/catalog/validate.test.ts && tsx src/lib/stripe/access.test.ts && tsx src/lib/stripe/affiliate-discount.test.ts && tsx src/lib/resend-from.test.ts && tsx src/lib/pos/idempotence.test.ts && tsx src/lib/plan-limits.test.ts && tsx src/lib/signup-otp.test.ts && tsx src/lib/assistant/assistant-setup.test.ts && tsx src/lib/llm/validateFormat.test.ts && tsx src/lib/security/tenant-isolation.test.ts && tsx src/lib/security/webhook-signatures.test.ts && tsx src/lib/security/platform-llm-fallback.test.ts && tsx src/lib/security/admin-roles.test.ts && tsx src/lib/security/defense-in-depth-wave1.test.ts && npm run test:tenant",
    "db:backfill-founder": "tsx scripts/backfill-founder-role.ts",
    "test:tenant": "tsx scripts/check-tenant-isolation.ts",
    "test:loop": "tsx scripts/test-loop.ts",
    "check:prod-env": "tsx scripts/check-prod-env.ts",
    "check:quick": "tsx scripts/anti-casse.ts && npm run check:prod-env",
    "check": "bash scripts/check.sh",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "next": "15.5.22",
    "next-auth": "^4.24.15",
    "pdf-parse": "^2.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^17.7.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "prisma": "^5.22.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vercel": "^58.5.1"
  }
}
